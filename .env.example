NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Local Docker connection. Replace with Supabase session-pooler connection for Render.
DATABASE_URL=postgresql://lex:lex_local_only@localhost:5432/lex
DATABASE_SSL=false
# Production: DATABASE_SSL=true. Optional PEM root CA if your database requires it.
# DATABASE_CA_CERT=
DATABASE_POOL_SIZE=5
# Generate secrets with npm run keys. Never use these placeholders in deployment.
API_CLIENTS_JSON=[{"id":"base44","secret":"REPLACE_WITH_GENERATED_SECRET","roles":["admin","operator","merchant","carrier"]}]
WEBHOOK_SECRETS_JSON={}
# Exact DNS hostnames permitted for outbound HTTPS webhooks, comma-separated.
WEBHOOK_ALLOWED_HOSTS=
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=10
DELIVERY_MAX_ATTEMPTS=5
