{
  "name": "LEX Reputation Recalculation",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 1 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Recalculates carrier reputation scores daily using the existing reputation engine",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lex_reputation_recalculation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "recalc_reputation": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "lexCarrierReputation",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Recalculate carrier reputation",
            "description": "Reputation engine"
          }
        }
      }
    ]
  }
}