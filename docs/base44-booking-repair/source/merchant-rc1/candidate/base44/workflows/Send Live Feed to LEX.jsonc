{
  "name": "Send Live Feed to LEX",
  "description": "Forwards every shipment custody/status event to the LEX platform as a live feed, skipping events that originated from LEX to avoid echo loops.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ShipmentEvent",
      "events": [
        "create"
      ]
    },
    "condition": "${ (.trigger.data.custodian // \"\") != \"LEX\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_live_feed_to_lex",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "dispatch_to_lex": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchPlatformEvent",
            "args": {
              "platform": "lex",
              "event": "custody_event",
              "shipment_id": "${ .trigger.data.shipment_id }",
              "data": {
                "location": "${ .trigger.data.location }",
                "custodian": "${ .trigger.data.custodian }",
                "verification_method": "${ .trigger.data.verification_method }",
                "occurred_at": "${ .trigger.data.occurred_at }"
              },
              "source_event_id": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send live feed to LEX",
            "description": "Forward shipment event"
          }
        }
      }
    ]
  }
}
