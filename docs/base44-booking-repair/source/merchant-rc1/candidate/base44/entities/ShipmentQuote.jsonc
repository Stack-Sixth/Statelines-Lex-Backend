{
  "name": "ShipmentQuote",
  "type": "object",
  "properties": {
    "quote_ref": {
      "type": "string",
      "description": "Human-readable quote reference"
    },
    "user_id": {
      "type": "string",
      "description": "Account the quote was issued to"
    },
    "merchant_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "consumed",
        "expired",
        "reserved"
      ],
      "default": "open"
    },
    "amount": {
      "type": "number",
      "description": "Total the merchant would pay (service + insurance - discounts + tax)"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "rate": {
      "type": "number",
      "description": "Service price before insurance, discounts and tax"
    },
    "insurance_fee": {
      "type": "number",
      "default": 0
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "promo_code": {
      "type": "string"
    },
    "promo_discount": {
      "type": "number",
      "default": 0
    },
    "rewards_points": {
      "type": "number",
      "default": 0
    },
    "rewards_discount": {
      "type": "number",
      "default": 0
    },
    "tax": {
      "type": "number",
      "default": 0
    },
    "service_level": {
      "type": "string"
    },
    "eta_days": {
      "type": "number",
      "default": 0
    },
    "weight_lb": {
      "type": "number",
      "default": 0
    },
    "declared_value": {
      "type": "number",
      "default": 0
    },
    "insurance": {
      "type": "boolean",
      "default": false
    },
    "origin_city": {
      "type": "string"
    },
    "destination_city": {
      "type": "string"
    },
    "pricing_authority": {
      "type": "string",
      "default": "statelines_rate_engine"
    },
    "rate_version": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_by_shipment_id": {
      "type": "string"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reservation_intent": {
      "type": "string"
    },
    "reservation_draft_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "amount",
    "rate_version",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
