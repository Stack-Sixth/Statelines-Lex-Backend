{
  "name": "LexPullPeer",
  "type": "object",
  "properties": {
    "connection_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "disabled"
    },
    "secret_env": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "merchant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lex_pull_nonce_state": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "connection_id",
    "status",
    "secret_env",
    "target",
    "merchant_ids"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
