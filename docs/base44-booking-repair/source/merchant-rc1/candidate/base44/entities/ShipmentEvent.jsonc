{
  "name": "ShipmentEvent",
  "type": "object",
  "properties": {
    "shipment_id": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "custodian": {
      "type": "string"
    },
    "verification_method": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "server_owner_user_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "server_nonce": {
      "type": "string"
    },
    "server_record_created_at": {
      "type": "string"
    },
    "server_record_proof": {
      "type": "string"
    },
    "server_artifact_ref": {
      "type": "string"
    }
  },
  "required": [
    "shipment_id",
    "event"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
