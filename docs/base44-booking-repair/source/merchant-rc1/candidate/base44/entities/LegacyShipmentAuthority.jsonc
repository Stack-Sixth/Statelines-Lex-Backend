{
  "name": "LegacyShipmentAuthority",
  "type": "object",
  "properties": {
    "shipment_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "snapshot_digest": {
      "type": "string"
    },
    "policy_epoch": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "evidence_ref": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "principals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revoked_by": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    }
  },
  "required": [
    "shipment_id",
    "owner_user_id",
    "merchant_id",
    "snapshot_digest",
    "policy_epoch",
    "evidence_ref"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
