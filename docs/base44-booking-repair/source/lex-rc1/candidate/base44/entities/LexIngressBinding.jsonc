{
  "name": "LexIngressBinding",
  "type": "object",
  "properties": {
    "connection_id": {
      "type": "string"
    },
    "tracking_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "proof": {
      "type": "object"
    }
  },
  "required": [
    "connection_id",
    "tracking_id",
    "status",
    "proof"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
