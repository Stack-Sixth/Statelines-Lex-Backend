{
  "name": "ShipmentLifecycleEvent",
  "type": "object",
  "properties": {
    "shipment_id": {
      "type": "string"
    },
    "tracking_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "created",
        "accepted",
        "merchant_dropoff",
        "exchange_partner_intake",
        "bundle_assigned",
        "carrier_assigned",
        "in_transit",
        "arrival",
        "last_mile_assigned",
        "delivered",
        "returned",
        "cancelled",
        "exception"
      ],
      "description": "Lifecycle stage entered by this transition"
    },
    "previous_stage": {
      "type": "string",
      "description": "Lifecycle stage this transition moved from"
    },
    "from_status": {
      "type": "string",
      "description": "Shipment.status before this transition"
    },
    "to_status": {
      "type": "string",
      "description": "Shipment.status after this transition"
    },
    "trigger_source": {
      "type": "string",
      "enum": [
        "engine",
        "operator",
        "platform",
        "carrier",
        "merchant",
        "system"
      ],
      "default": "operator"
    },
    "responsible_entity": {
      "type": "string",
      "description": "Entity responsible for the transition"
    },
    "note": {
      "type": "string"
    },
    "audit_ref": {
      "type": "string",
      "description": "AuditLog entry id backing this transition"
    },
    "command_id": {
      "type": "string",
      "description": "Stable idempotency key supplied by the caller; reused replays return the original result"
    },
    "command_hash": {
      "type": "string",
      "description": "Hash of the command payload; reused command_id with a different hash is rejected"
    },
    "result": {
      "type": "object",
      "description": "Snapshot of the transition result, returned verbatim on idempotent replay"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "lex_transition_ref": {
      "type": "string"
    }
  },
  "required": [
    "shipment_id",
    "stage"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
